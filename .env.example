# Keep this true for local and deployed demos. The mock adapter is the default
# even when this file is absent.
USE_MOCK_ORDER_API=true

# Only used when USE_MOCK_ORDER_API=false.
ORDER_API_URL=http://172.31.14.81:5000

# Optional language interpretation layer. Rules remain the default and fallback.
AI_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free
# Optional attribution headers shown in OpenRouter activity/leaderboards.
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=QuickCart Support Automation
AI_TIMEOUT_MS=45000

# Generic OpenAI-compatible fallback (only used when the OpenRouter variables above are absent).
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
